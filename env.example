# Copy to .env next to the binary (or export in the shell). Never commit this file.
# Bark app → 通知 → 复制设备密钥 / device key.
PLUTUS_BARK_KEY=
# Official server, or your self-hosted Bark endpoint with no trailing slash.
PLUTUS_BARK_SERVER=https://api.day.app
# Shown in every heartbeat so you can tell machines apart.
PLUTUS_NODE_NAME=
# Optional overrides (config.toml still wins for most settings).
# PLUTUS_THREADS=1
# PLUTUS_CPU_PERCENT=40
# PLUTUS_CONFIG=/opt/plutus-rustus/config.toml
