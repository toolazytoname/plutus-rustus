#!/usr/bin/env bash
# Single operator entry: install, start, stop, status, logs, upgrade.
# Prefers systemd; falls back to shell/start.sh when no unit is installed.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# shellcheck source=common.sh
source "$ROOT/shell/common.sh"

BIN="$(plutus_resolve_bin "$ROOT" || true)"
UNIT_NAME="plutus.service"
PROFILE="${PLUTUS_PROFILE:-low}"
PROFILE_SET=0
FETCH_DB=0
DO_START=0
FROM_SOURCE=0
export PATH="${HOME}/.cargo/bin:${PATH}"

load_env() {
  if [[ -f "$ROOT/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$ROOT/.env"
    set +a
  fi
  export PLUTUS_CONFIG="${PLUTUS_CONFIG:-$ROOT/config.toml}"
}

have_systemd_unit() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl cat "$UNIT_NAME" >/dev/null 2>&1
}

usage() {
  cat <<EOF
usage: $(basename "$0") <command>

  install [--profile=low|balanced|full] [--fetch-db] [--start] [--from-source]
  start     start via systemd, or the shell supervisor
  stop      stop systemd or the shell supervisor
  status    live engine JSON (and systemd status when installed)
  logs      follow journal or logs/plutus.log
  doctor    check config, snapshot, notify wiring
  upgrade   download the latest Release binary and restart
  update-db download a fresh funded-address snapshot

docs: docs/DEPLOY.md
EOF
}

set_kv_file() {
  local file="$1" key="$2" value="$3"
  [[ -n "$value" ]] || return 0
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    awk -v k="$key" -v v="$value" '
      index($0, k "=") == 1 { print k "=" v; next }
      { print }
    ' "$file" >"$file.tmp" && mv "$file.tmp" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >>"$file"
  fi
}

cpu_quota_from_config() {
  local p
  p="$(awk -F'"' '/^profile = / { print $2; exit }' "$ROOT/config.toml" 2>/dev/null || true)"
  case "$p" in
    low) echo "40%" ;;
    balanced) echo "70%" ;;
    full) echo "100%" ;;
    *) echo "40%" ;;
  esac
}

apply_profile() {
  local file="$ROOT/config.toml"
  case "$PROFILE" in
    low | balanced | full) ;;
    *)
      echo "profile must be low, balanced, or full" >&2
      exit 1
      ;;
  esac
  awk -v p="$PROFILE" '
    /^profile = / { print "profile = \"" p "\""; next }
    { print }
  ' "$file" >"$file.tmp" && mv "$file.tmp" "$file"
  case "$PROFILE" in
    low) export PLUTUS_CPU_QUOTA="${PLUTUS_CPU_QUOTA:-40%}" ;;
    balanced) export PLUTUS_CPU_QUOTA="${PLUTUS_CPU_QUOTA:-70%}" ;;
    full) export PLUTUS_CPU_QUOTA="${PLUTUS_CPU_QUOTA:-100%}" ;;
  esac
  echo "profile=$PROFILE cpu_quota=$PLUTUS_CPU_QUOTA"
}

parse_install_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        PROFILE="$2"
        PROFILE_SET=1
        shift 2
        ;;
      --profile=*)
        PROFILE="${1#*=}"
        PROFILE_SET=1
        shift
        ;;
      --fetch-db) FETCH_DB=1; shift ;;
      --start) DO_START=1; shift ;;
      --from-source) FROM_SOURCE=1; shift ;;
      *)
        echo "unknown install option: $1" >&2
        exit 1
        ;;
    esac
  done
}

require_bin() {
  BIN="$(plutus_resolve_bin "$ROOT" || true)"
  if [[ -z "$BIN" ]]; then
    echo "missing binary under $ROOT/bin or $ROOT/target/release — run: $ROOT/install.sh" >&2
    exit 1
  fi
}

cmd_install() {
  if [[ ! -f "$ROOT/config.toml" ]]; then
    cp "$ROOT/config.example.toml" "$ROOT/config.toml"
    echo "wrote config.toml"
    PROFILE_SET=1
  fi
  if [[ "$PROFILE_SET" -eq 1 ]]; then
    apply_profile
  else
    export PLUTUS_CPU_QUOTA="${PLUTUS_CPU_QUOTA:-$(cpu_quota_from_config)}"
  fi
  if [[ ! -f "$ROOT/.env" ]]; then
    cp "$ROOT/env.example" "$ROOT/.env"
    echo "wrote .env"
  fi
  set_kv_file "$ROOT/.env" "PLUTUS_BARK_KEY" "${PLUTUS_BARK_KEY:-}"
  set_kv_file "$ROOT/.env" "PLUTUS_NODE_NAME" "${PLUTUS_NODE_NAME:-}"
  mkdir -p "$ROOT/data" "$ROOT/findings" "$ROOT/logs" "$ROOT/bin"

  if [[ "$FROM_SOURCE" -eq 1 ]]; then
    if [[ -d "$ROOT/.git" ]]; then
      git -C "$ROOT" submodule update --init --recursive
    fi
    echo "building release binary (native CPU)"
    cargo rustc --release -- -C target-cpu=native
    mkdir -p "$ROOT/bin"
    cp "$ROOT/target/release/plutus-rustus" "$ROOT/bin/plutus-rustus"
  fi

  require_bin
  load_env
  "$BIN" doctor || true
  if [[ "$(id -u)" -eq 0 ]]; then
    bash "$ROOT/shell/install-systemd.sh"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    sudo env PLUTUS_CPU_QUOTA="${PLUTUS_CPU_QUOTA:-40%}" PLUTUS_ROOT="$ROOT" bash "$ROOT/shell/install-systemd.sh"
  else
    echo "no passwordless sudo; start with: $ROOT/shell/plutus start"
  fi
  if [[ "$FETCH_DB" -eq 1 ]]; then
    "$BIN" data update
  fi
  if [[ "$DO_START" -eq 1 ]]; then
    cmd_start
  else
    echo
    echo "next:"
    echo "  $ROOT/shell/plutus update-db   # first snapshot, ~1.4GB download"
    echo "  $ROOT/shell/plutus start"
  fi
}

cmd_start() {
  load_env
  require_bin
  if have_systemd_unit; then
    if [[ "$(id -u)" -eq 0 ]]; then
      systemctl start "$UNIT_NAME"
    elif systemctl start "$UNIT_NAME" 2>/dev/null; then
      :
    else
      sudo systemctl start "$UNIT_NAME"
    fi
    systemctl --no-pager --full status "$UNIT_NAME" | head -n 12 || true
    return
  fi
  bash "$ROOT/shell/start.sh"
}

cmd_stop() {
  if have_systemd_unit && systemctl is-active --quiet "$UNIT_NAME"; then
    if [[ "$(id -u)" -eq 0 ]]; then
      systemctl stop "$UNIT_NAME"
    else
      systemctl stop "$UNIT_NAME" 2>/dev/null || sudo systemctl stop "$UNIT_NAME"
    fi
    echo "stopped systemd unit $UNIT_NAME"
    return
  fi
  bash "$ROOT/shell/stop.sh"
}

cmd_status() {
  if have_systemd_unit; then
    systemctl --no-pager --full status "$UNIT_NAME" | head -n 16 || true
    echo
  fi
  bash "$ROOT/shell/status.sh"
}

cmd_logs() {
  if have_systemd_unit; then
    exec journalctl -u "$UNIT_NAME" -f -n 100
  fi
  exec bash "$ROOT/shell/logs.sh"
}

cmd_doctor() {
  load_env
  require_bin
  "$BIN" doctor
}

cmd_upgrade() {
  local url="${PLUTUS_INSTALL_URL:-https://raw.githubusercontent.com/${PLUTUS_GITHUB:-toolazytoname/plutus-rustus}/main/install.sh}"
  echo "re-running installer from $url"
  curl -fsSL "$url" | bash -s -- --dir "$ROOT"
  require_bin
  if have_systemd_unit; then
    if [[ "$(id -u)" -eq 0 ]]; then
      systemctl restart "$UNIT_NAME"
    else
      systemctl restart "$UNIT_NAME" 2>/dev/null || sudo systemctl restart "$UNIT_NAME"
    fi
    echo "restarted $UNIT_NAME"
  elif [[ -f "$ROOT/data/supervisor.pid" ]]; then
    bash "$ROOT/shell/stop.sh" || true
    bash "$ROOT/shell/start.sh"
  else
    echo "binary updated. start with: $ROOT/shell/plutus start"
  fi
}

cmd_update_db() {
  load_env
  require_bin
  "$BIN" data update
  if have_systemd_unit; then
    systemctl try-restart "$UNIT_NAME" 2>/dev/null || sudo systemctl try-restart "$UNIT_NAME" || true
  fi
}

cmd="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi
case "$cmd" in
  install)
    parse_install_args "$@"
    cmd_install
    ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  doctor) cmd_doctor ;;
  upgrade) cmd_upgrade ;;
  update-db) cmd_update_db ;;
  -h | --help | help | "") usage ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
